{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdnest",
  "version": "0.1.1",
  "identifier": "app.mdnest.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MD Nest",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "resources": {
      "resources/themes/": "themes/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "MD Nest - a Typora-style Markdown editor",
    "longDescription": "MD Nest is a live-preview (WYSIWYG) Markdown editor compatible with Typora themes.",
    "linux": {
      "deb": {
        "desktopTemplate": "deb/mdnest.desktop",
        "section": "editors",
        "depends": [
          "libssl3 | libssl3t64"
        ]
      }
    }
  },
  "mainBinaryName": "mdnest"
}
