{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability",
  "windows": ["main", "w-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:webview:allow-set-webview-zoom"
  ]
}
